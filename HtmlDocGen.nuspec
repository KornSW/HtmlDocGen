<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>HtmlDocGen</id>
    <version>1.0.2</version>
    <title>HtmlDocGen</title>
    <authors>KornSW</authors>
    <owners>KornSW</owners>
    <!-- https://spdx.org/licenses/ -->
    <license type="expression">GPL-3.0-only</license>
    <projectUrl>https://github.com/KornSW/HtmlDocGen</projectUrl>
    <iconUrl>https://github.com/KornSW/HtmlDocGen/blob/master/PackageIcon.png?raw=true</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>HTML Document Generator</description>
    <releaseNotes></releaseNotes>
    <copyright>Copyright KornSW</copyright>
    <tags>HTML Document Generator PDF wkhtmltopdf</tags>
    <dependencies>
      <group>
        <dependency id="kSystemExtensions" version="2.2.1" />
        <dependency id="ComponentDiscovery" version="3.1.2" />
      </group>
    </dependencies>
  </metadata>
  <files>

    <!-- https://docs.microsoft.com/en-us/nuget/create-packages/creating-a-package#from-a-convention-based-working-directory -->
    
    <file src="(Stage)\bin\HtmlDocGen.dll" target="lib/{tfm}" />
    <file src="(Stage)\bin\HtmlDocGen.xml" target="lib/{tfm}" />
    <file src="(Stage)\bin\HtmlDocGen.pdb" target="lib/{tfm}" />

    <file src="HtmlDocGen\HtmlDocGen\(Runtimes)\libeay32.dll" target="WkhtmlRuntimes" />
    <file src="HtmlDocGen\HtmlDocGen\(Runtimes)\libgcc_s_dw2-1.dll" target="WkhtmlRuntimes" />
    <file src="HtmlDocGen\HtmlDocGen\(Runtimes)\mingwm10.dll" target="WkhtmlRuntimes" />
    <file src="HtmlDocGen\HtmlDocGen\(Runtimes)\msvcp120.dll" target="WkhtmlRuntimes" />
    <file src="HtmlDocGen\HtmlDocGen\(Runtimes)\msvcr120.dll" target="WkhtmlRuntimes" />
    <file src="HtmlDocGen\HtmlDocGen\(Runtimes)\pdftk.exe" target="WkhtmlRuntimes" />
    <file src="HtmlDocGen\HtmlDocGen\(Runtimes)\ssleay32.dll" target="WkhtmlRuntimes" />
    <file src="HtmlDocGen\HtmlDocGen\(Runtimes)\wkhtmltopdf.exe" target="WkhtmlRuntimes" />
    <file src="HtmlDocGen\HtmlDocGen\(Runtimes)\wkhtmltox0.dll" target="WkhtmlRuntimes" />
    
    <!-- Build-Targets zum kopieren der non-.NET Runtimes in den build-output -->
    <file src="HtmlDocGen\HtmlDocGen\CopyWkHtmlToPdfRuntimesToOutdir.targets" target="build/net46/CopyWkHtmlToPdfRuntimesToOutdir.targets" />

    <!-- Build-Targets, welche bei der Nuget-Package Installation automatisch in die Projektdatei indiziert werden -->
    <file src="HtmlDocGen\HtmlDocGen\InjectIntoProjectFile.targets" target="build/net46/HtmlDocGen.targets" />
    
  </files>
</package>